{
  "_comment": "Phrase groups used by the sentiment, priority, state and preprocessing components. A trailing * matches any word ending. Groups from the first Phase 1 lexicons keep their exact phrases so existing behaviour is unchanged.",
  "weights": {"frustration_phrase": 2},
  "groups": [
    {"id": "sentiment.positive_strong", "phrases": ["thank you so much", "excellent", "perfect", "fantastic", "wonderful", "great job", "very helpful", "really appreciate", "delighted", "awesome"], "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."},
    {"id": "sentiment.positive_weak", "phrases": ["thanks", "thank you", "appreciate*", "great", "good", "helpful", "happy", "pleased", "resolved", "glad", "works now", "working now", "solved", "well done"], "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."},
    {"id": "sentiment.negative_strong", "phrases": ["unacceptable", "not acceptable", "ridiculous", "terrible", "horrible", "worst", "useless", "disgusting", "waste of", "furious", "angry", "outraged", "incompetent"], "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."},
    {"id": "sentiment.negative_weak", "phrases": ["problem*", "issue*", "wrong", "error*", "fail*", "not working", "unable", "cannot", "can't", "cant", "disappointed", "unhappy", "bad", "poor", "delay*", "waiting", "not received", "missing", "confusing", "confused", "worried", "concern*", "difficult", "unfortunately", "mistake*", "rejected"], "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."},
    {"id": "sentiment.frustration", "phrases": ["again and again", "multiple times", "several times", "many times", "still not", "still no", "nobody", "no one", "no-one", "already submitted", "already sent", "already provided", "already uploaded", "yet again", "once again", "how many times", "fed up", "sick of", "unacceptable", "ridiculous", "waste of time", "no response", "not resolved", "never resolved"], "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."},

    {"id": "priority.urgent", "phrases": ["urgent*", "asap", "immediately", "emergency", "critical", "system down", "server down", "outage", "final notice"], "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon (includes the keyword ideas of the retired email_worker.py)."},
    {"id": "priority.legal", "phrases": ["legal action", "lawyer", "solicitor", "court", "sue", "consumer forum"], "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."},
    {"id": "priority.deadline", "phrases": ["deadline", "by tomorrow", "by today", "expires", "expiring", "last date", "due date", "before friday", "before monday"], "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."},
    {"id": "priority.blocking", "phrases": ["cannot access", "can't access", "unable to", "not able to", "blocked", "locked out", "security", "data loss", "major"], "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."},
    {"id": "priority.repeat", "phrases": ["already submitted", "already sent", "already provided", "already uploaded", "multiple times", "several times", "many times", "again and again", "still not", "still no", "nobody", "no one", "no-one", "no response", "not resolved", "never resolved", "yet again", "once again"], "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."},
    {"id": "priority.issue", "phrases": ["error*", "issue*", "bug*", "slow", "login", "problem*", "not working", "fail*"], "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."},

    {"id": "message.automated", "phrases": ["mail system at host", "could not be delivered", "undelivered mail returned to sender", "delivery status notification", "one-time password", "do not share this otp", "this is an automated"], "origin": "data", "review": "established", "note": "Markers of the system-generated messages found in stored tickets: bounce notices and OTP emails. These are not customer conversation."},
    {"id": "message.information_request", "phrases": ["please review and upload", "please update the following", "please upload", "please provide", "please send", "please share", "kindly provide", "kindly upload", "please assist with"], "origin": "code", "review": "established", "note": "Wording of the existing outbound templates (verificationIssue, 'Correction Required', 'Education Verification Request')."},
    {"id": "message.information_request_extra", "phrases": ["could you please", "can you please send", "we need you to"], "origin": "inferred", "review": "needs_review", "note": "Common request wording that is not in the existing templates. Confirm."},
    {"id": "message.acknowledgement", "phrases": ["we are reviewing", "under review", "we will update you", "we will get back", "we are looking into"], "origin": "inferred", "review": "needs_review", "note": "Typical acknowledgement wording; not taken from stored data. Confirm."},
    {"id": "message.closing", "phrases": ["thank you for your assistance", "thank you", "thanks"], "origin": "data", "review": "established", "note": "'Thank you for your assistance.' appears in stored messages; thanks / thank you are in the lexicon."},
    {"id": "message.open_request", "phrases": ["any update", "update on", "when will", "how long", "status", "why", "what is"], "origin": "data", "review": "established", "note": "'Any update on this?' appears in stored messages; the others are in the status_request intent."},
    {"id": "message.open_request_extra", "phrases": ["please", "can you", "could you", "i need", "kindly"], "origin": "inferred", "review": "needs_review", "note": "Generic request markers. Confirm."},
    {"id": "message.resolution_claim", "phrases": ["works now", "working now", "is resolved", "has been resolved", "solved"], "origin": "lexicon", "review": "established", "note": "A customer saying this is a claim, not a verified resolution."},
    {"id": "message.problem", "phrases": ["problem*", "issue*", "error*", "rejected", "not accepted", "incorrect", "wrong", "not working", "cannot", "unable", "failed", "insufficient"], "origin": "lexicon", "review": "established", "note": "Union of existing problem words plus 'insufficient' from stored subjects."}
  ],
  "patterns": [
    {"id": "frustration.times", "regex": "(?<!\\w)(?:two|three|four|five|six|several|many|\\d+)\\s+times(?!\\w)", "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."},
    {"id": "frustration.nth_time", "regex": "(?<!\\w)for the (?:second|third|fourth|fifth|sixth|\\w+th) time(?!\\w)", "origin": "lexicon", "review": "established", "note": "Phase 1 lexicon."}
  ]
}
